# Private settings: copy to secrets.yaml (not in git) and change the values

# Backend URL and optional credentials for http authentication
backend:
    url:  "https://example.com/tschenggins-laempli/"
    # user: "someuser"
    # pass: "somepassword"

# Wi-Fi networks to configure, ordered by priority
wifis:
    - ssid: "somessid"
      pass: "somepassword"
    - ssid: "anotherssid"
      pass: "anotherpassword"

# Backend server for tools/deploy.py (command line options override these)
deploy:
    host: "server"                                          # ssh host (no password prompt)
    dir:  "/home/someuser/TschengginsLaempliByClaudine"     # git clone on the server
    # service: "tschenggins-laempli"                        # systemd user unit (default)
